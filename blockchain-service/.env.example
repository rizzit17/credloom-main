# Blockchain service configuration
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
NETWORK_NAME=Credloom Local Testnet (Hardhat)

# Shared secret with the Node API. Write endpoints require the X-Service-Key header.
SERVICE_API_KEY=change-me-to-a-long-random-string

# Custodial demo wallets are derived from the PUBLIC Hardhat mnemonic.
# NEVER set DEMO_MODE=true on a real network.
DEMO_MODE=true

# Optional overrides. By default addresses come from deployment.json written by `npm run deploy`.
# BACKEND_PRIVATE_KEY=
# REPUTATION_REGISTRY_ADDRESS=
# INSURANCE_POOL_ADDRESS=
# LOAN_ESCROW_ADDRESS=
# LIQUIDITY_POOL_ADDRESS=
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
