# Server
PORT=3001
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Database: "sqlite" (zero-config, default) or "supabase" (run src/db/supabase_migration.sql first)
DB_DRIVER=sqlite
# SQLITE_FILE=./data/credloom.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Other services
CHAIN_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_URL=http://127.0.0.1:5001
SERVICE_API_KEY=same-value-as-blockchain-service

# Keeper that settles overdue loans automatically
AUTO_DEFAULT=true
AUTO_DEFAULT_INTERVAL_MS=10000
DEMO_MODE=true
